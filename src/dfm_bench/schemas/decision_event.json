        "null"
      ]
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "goal": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    }
